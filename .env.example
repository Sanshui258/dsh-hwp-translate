# 复制本文件为 .env 后填写真实值；不要把真实 Key 提交到 Git
# 默认对接阿里巴巴千问（DashScope）OpenAI 兼容接口
AI_API_KEY=YOUR_DASHSCOPE_API_KEY
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
# 多模态模型（识别图片内文字/排版）示例：qwen-vl-plus、qwen2.5-vl-72b-instruct
# AI_MODEL=qwen-vl-plus
# Key 记忆：1 = 记住各家服务商用过的 Key（存在 model_api/key_memory.json，仅本机），
# 切换服务商时自动填回上次那个；0 = 不读不写。分享程序目录前请删掉 model_api/
AI_KEY_MEMORY=1

# 翻译语言：第一/第二源语言 -> 目标语言（作为系统提示词变量注入模型）
SOURCE_LANG_1=ko
SOURCE_LANG_2=en
TARGET_LANGUAGE=zh-CN
# 处理模式：hybrid=混合（默认可编辑文本走文本、没有文本自动转视觉）/ vision=纯视觉
# （旧配置里的 LAYOUT_MODE 仍被识别为同一项的别名，以本键为准）
PROCESSING_MODE=hybrid
# 并发线程数：调用模型 / HoG 计算的并行度。1 = 完全串行（旧行为）
# 注意：PowerPoint/WPS 的 COM 渲染固定串行（COM 单线程套间），不参与并发
MAX_CONCURRENCY=4

# 字号策略：fixed=所有译文统一使用 TRANSLATION_FONT_SIZE（默认 12pt）
#           ratio=按原框字号 x TRANSLATION_FONT_SIZE_RATIO（7/16），并以 TRANSLATION_FONT_SIZE 保底
TRANSLATION_FONT_SIZE_MODE=fixed
TRANSLATION_FONT_SIZE_RATIO=0.4375  # 仅 ratio 模式使用：字号 = 原框字号 x 7/16
TRANSLATION_FONT_SIZE=12  # 统一字号（fixed 模式）与保底字号（ratio 模式）
TRANSLATION_MIN_FONT_SIZE=6
TRANSLATION_MAX_FONT_SIZE=28

# 译文样式（混合 / 纯视觉 / 原地替换三种模式共用；留空则按目标语言自动选择字体）
# 默认字体：目标英语 -> SimHei(黑体)；目标中文 -> SimSun(宋体)；目标韩语 -> Malgun Gothic(맑은 고딕)
TRANSLATION_FONT=
TRANSLATION_COLOR=000000  # 文字颜色（6 位十六进制）
TRANSLATION_BOLD=1

# 视觉模式：1 = 渲染页面 -> 多模态模型提取翻译 -> HoG 布局（需要 PowerPoint + qwen-vl）
VISION_MODE=0
# AI 前后校对：对照原文核查译文，出错自动修正并重新排版。
# 1.5.2 起默认关闭、界面不再提供入口（实测收益有限，却多花约 8% 调用）；需要时设 1
AI_PROOFREAD=0
# JSON 模式（结构化输出）：auto = 服务商支持时自动启用 response_format（默认；
# 覆盖 OpenAI / DeepSeek / 智谱 / 千问 / Kimi）；on = 强制开启；off = 关闭
# 个别中转声称兼容但不认这个字段，遇到 400 时设 off
AI_JSON_MODE=auto
# 翻译源：api = 大模型接口（默认）；google / mymemory = 网页翻译应急（不需要 Key，质量较低，看不了图）
MT_ENGINE=api
# 网页翻译的分批规则：每批约 800 字符，单批硬上限 1000 字符；
# 每批带上一批末尾 ≤200 字符的整行做"语言线索"，上一批超过 300 行就不带
MT_BATCH_CHARS=800
MT_HARD_CHARS=1000
MT_CTX_CHARS=200
MT_CTX_MAX_LINES=300
# PDF 处理方式：auto = 有文本层就按"行位置"精确排版（推荐，便宜且准），
#   没有文本层（扫描件）自动回退纯视觉；text = 强制文本层；vision = 保持旧的纯视觉
PDF_MODE=auto
# 演讲者备注：1 = 也翻译（原文保留，译文追加在备注后面）；0 = 不翻
TRANSLATE_NOTES=0
# 翻译后生成 HTML 检查报告（同目录 *_review.html）：1=生成，0=关闭
REVIEW_HTML=1
# 术语表分组名（glossary/<分组>.json），留空则不用术语表
# 场景预设：read=自己看懂 / lecture=讲课投影 / deliver=直接交付（留空=自定义）
PRESET=
GLOSSARY_GROUP=
# 翻译时是否带上所在分段标题作为上下文：1=带（默认），0=不带
SEGMENT_CONTEXT=1
# 原地替换（混合/文本模式可选）：1 = 译文直接写回原文本框，原文写入该页备注；0 = 原文旁新增译文框
INPLACE_REPLACE=0
# 原地替换时的字号策略（与上面 TRANSLATION_FONT_SIZE_MODE 分开）：
#   keep = 沿用原框字号（默认；原地替换改成统一字号会很突兀）
#   fixed = 统一用 TRANSLATION_FONT_SIZE；ratio = 沿用原字号、缺省时用 TRANSLATION_FONT_SIZE
INPLACE_FONT_SIZE_MODE=keep
# Word / 한글 文档（.docx / .doc / .hwpx / .hwp）字号策略：
#   keep = 沿用原字号（默认，原位替换不该整篇改字号）
#   fixed = 统一用 TRANSLATION_FONT_SIZE；ratio = 原字号 x TRANSLATION_FONT_SIZE_RATIO
DOC_FONT_SIZE_MODE=keep
# Word / 한글 文档里的插图是否也走多模态提取译文：1 = 是（默认），0 = 跳过插图
DOC_IMAGE_VISION=1
# HoG 多尺度网格（2x2 -> 4x4 -> 8x8），取全局最低活跃度块
LAYOUT_BLANK_SCALES=2,4,8
# 排版精细度档位：HoG 细网格 / 原文附近空位搜索的块尺寸 = 1/该值 页宽。
# 6=粗略 8=标准 10=精细(默认，推荐) 12=极细；块越细越容易把译文放在原文近旁
LAYOUT_FINE_DIV=10
# 视觉模式：原文附近找空白块的搜索范围（相对 HoG 块尺寸的倍数）。
# 调大 = 在更大范围内找空位，避免内容都堆在同一个角落
LAYOUT_NEAR_BLOCK_RADIUS=3.0
# 空白块优先寻找方向：top-right=从右上开始找（默认）/ bottom-left=左下 / lowest=纯最低活跃度
LAYOUT_BLOCK_ORIGIN=top-right
# 可用空白块的最小尺寸（相对页面长边的比例）：太小会挤成一堆落到最下方，至少设 1/4~1/5
LAYOUT_MIN_BLOCK_RATIO=0.25

# 译文框宽（相对页宽）：上限 0.60 / 原框过宽时的兜底下限 0.25。
# 调小 = 长译文折成更窄的一列（框更贴近文字，但行数变多、更容易与别的框相撞）
LAYOUT_BOX_MAX_RATIO=0.60
LAYOUT_BOX_FLOOR_RATIO=0.25
# 近旁四个方向都放不下时的收窄重试比例：把框宽压到原宽的该比例再找原文近旁空位
LAYOUT_BOX_NARROW_RATIO=0.6
# 收窄重试放宽：1 = 严格判据放不下时允许译文框压住图形/底纹（只保证不压别的文本框）；
# 0 = 只接受完全不压像素内容的近旁空位（更干净，但更容易被甩到页面另一头）
LAYOUT_NARROW_ALLOW_GRAPHICS=1
# 排版方向是否用 HoG/熵判断：1 = 渲染页面算活动度，按"左右优先、同组最空"选方向
# （无 PowerPoint 或渲染失败时自动回退默认顺序）；0 = 关闭
LAYOUT_HOG_SIDE_PRIORITY=1

# 翻译专家系统提示词文件（可编辑，缺省 prompts/translate_system.txt）
AI_SYSTEM_PROMPT_FILE=prompts/translate_system.txt
# 上下文窗口（token）与自动压缩阈值：单次调用输入估算超过 预算=窗口x比例 时自动拆分批次
AI_TIMEOUT_SEC=180  # 单次 API 请求读超时秒数（慢模型可调大）
AI_CONTEXT_WINDOW=32768
AI_CONTEXT_RATIO=0.6

# 大文件自动拆分：页数或估算上下文超过阈值时，拆成 2 个文件分译后合并（需要 PowerPoint）
SPLIT_MAX_PAGES=50
SPLIT_MAX_CONTEXT_TOKENS=400000

INPUT_DIR=input
OUTPUT_DIR=output

# 翻译成功后把输入目录里的原文件移到 <输入目录>/translated（避免下次启动重复读取）
# 1 = 开启（默认）；0 = 保留原文件不动
ARCHIVE_TRANSLATED=1
# 输出同名策略：ask=GUI 弹窗询问 / rename=自动加序号 / overwrite=覆盖 / cancel=跳过
OUTPUT_CONFLICT_POLICY=ask

# 接口方言：auto=按服务商自动识别（Claude 官方 -> /v1/messages）
# 也可强制 openai（chat/completions）/ anthropic（Claude Messages API）
AI_API_DIALECT=auto


# 界面主题：system=跟随 Windows 应用主题 / light=浅色 / dark=深色（默认跟随系统）
GUI_THEME=system
# 界面语言：zh=中文 / en=英文 / ko=韩文（切换后写回本键）
GUI_LANG=zh
# 界面后端：auto=自动（有 PySide6 用新界面，否则旧界面）/ qt=强制新界面 / tk=强制旧界面
GUI_BACKEND=auto
# 历史记录：保留最近多少次运行快照（reports/history/，GUI「历史记录」可回看）
HISTORY_KEEP=200
