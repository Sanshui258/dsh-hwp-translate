{
  "name": "dsh-hwp-translate",
  "version": "0.2.0",
  "description": "Translate HWP/HWPX (한글) documents into Chinese with layout preserved. Ships the 14 MB Yeobaek translator, so no separate install is needed.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "hwp-translate": "bin/hwp-translate.js"
  },
  "icon": "./icon.png",
  "files": [
    "lib",
    "bin",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "PROVENANCE.md",
    ".env.example"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hwp",
    "hwpx",
    "hangul",
    "한글",
    "translation",
    "korean"
  ],
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanshui258/dsh-hwp-translate.git"
  },
  "homepage": "https://github.com/Sanshui258/dsh-hwp-translate#readme",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  }
}
